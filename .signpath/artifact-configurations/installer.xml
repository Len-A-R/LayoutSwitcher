<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the zip uploaded by the
     release workflow with LayoutSwitcher-Setup-<version>.exe (Inno Setup).
     Paste it into the SignPath project (Artifact configurations ->
     installer). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="LayoutSwitcher-Setup-${version}.exe" product-name="LayoutSwitcher"
             product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
