<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "executables": the zip uploaded by the
     release workflow with LS-x64.exe and LS-x86.exe.  Paste it into the
     SignPath project (Artifact configurations -> executables).  Product name
     and version are enforced as required by SignPath Foundation; the version
     is passed by .github/workflows/release.yml. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="LS-x64.exe" product-name="LayoutSwitcher" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="LS-x86.exe" product-name="LayoutSwitcher" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
